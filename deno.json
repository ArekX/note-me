{
    "tasks": {
        "cli": "deno run -A cli/mod.ts",
        "cache": "deno cache -r --lock deno.lock --allow-scripts=npm:fsevents main.ts cli/mod.ts frontend/deps.ts",
        "cache-ci": "deno cache --lock deno.lock --allow-scripts=npm:fsevents main.ts cli/mod.ts frontend/deps.ts",
        "check": "deno fmt --check && deno lint && deno run -A check.ts",
        "dev": "deno run -A npm:vite",
        "update": "deno run -A -r jsr:@fresh/update .",
        "build-docker": "docker build --build-arg BUILD_ID=$(date +%s) . -t arekxv/note-me:$(git describe --tags --abbrev=0)",
        "build-podman": "podman build --build-arg BUILD_ID=$(date +%s) . -t \"arekxv/note-me:$(git describe --tags --abbrev=0)\"",
        "build-assets": "deno run -A npm:vite build",
        "production": "deno run -A production.ts",
        "debug": "deno run --inspect-wait -A npm:vite",
        "preview": "deno run -A production.ts",
        "build": "deno run -A npm:vite build"
    },
    "lint": {
        "rules": {
            "tags": ["fresh", "recommended"],
            "exclude": ["jsx-curly-braces"]
        }
    },
    "exclude": ["**/_fresh/*"],
    "fmt": { "indentWidth": 4 },
    "imports": {
        "fresh": "jsr:@fresh/core@^2.3.3",
        "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
        "vite": "npm:vite@^7.1.3",
        "@types/babel__core": "npm:@types/babel__core@^7.20.5",
        "preact": "npm:preact@^10.29.1",
        "@preact/signals": "npm:@preact/signals@^2.9.0",
        "tailwindcss": "npm:tailwindcss@^4.1.10",
        "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
        "mermaid": "npm:mermaid@^11.10.1",
        "highlight.js": "npm:highlight.js@^11.9.0",
        "zod": "npm:zod@^4.4.0",
        "kysely": "npm:kysely@^0.29.5",
        "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
        "@opentf/obj-diff": "jsr:@opentf/obj-diff@^0.12.0",
        "@simplewebauthn/server": "jsr:@simplewebauthn/server@^13.3.2",
        "@simplewebauthn/browser": "npm:@simplewebauthn/browser@^13.1.2",
        "@lezer/highlight": "npm:@lezer/highlight@^1.2.1",
        "@codemirror/state": "npm:@codemirror/state@^6.7.1",
        "@codemirror/view": "npm:@codemirror/view@^6.43.9",
        "@codemirror/commands": "npm:@codemirror/commands@^6.7.1",
        "@codemirror/language": "npm:@codemirror/language@^6.10.6",
        "@codemirror/autocomplete": "npm:@codemirror/autocomplete@^6.18.3",
        "@codemirror/lang-markdown": "npm:@codemirror/lang-markdown@^6.3.2",
        "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@3.1111.0",
        "@aws-sdk/credential-provider-env": "npm:@aws-sdk/credential-provider-env@3.972.69",
        "@aws-sdk/lib-storage": "npm:@aws-sdk/lib-storage@3.1111.0",
        "@std/datetime": "jsr:@std/datetime@^0.225.7",
        "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
        "@std/encoding": "jsr:@std/encoding@^1.0.11",
        "@std/fs": "jsr:@std/fs@^1.0.24",
        "@std/http": "jsr:@std/http@^1.1.3",
        "@std/log": "jsr:@std/log@^0.224.14",
        "@std/path": "jsr:@std/path@^1.1.6",
        "bcrypt": "https://deno.land/x/bcrypt@v0.4.1/mod.ts",
        "semaphore": "https://deno.land/x/semaphore@v1.1.1/mod.ts",
        "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.0",
        "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
        "$components/": "./components/",
        "$islands/": "./islands/",
        "$backend/": "./backend/",
        "$workers/": "./workers/",
        "$schemas/": "./schemas/",
        "$frontend/": "./frontend/",
        "$cli/": "./cli/",
        "$lib/": "./lib/",
        "$types": "./types/mod.ts",
        "$db": "./workers/database/lib.ts"
    },
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
        "jsx": "precompile",
        "jsxImportSource": "preact",
        "jsxPrecompileSkipElements": [
            "a",
            "img",
            "source",
            "body",
            "html",
            "head",
            "title",
            "meta",
            "script",
            "link",
            "style",
            "base",
            "noscript",
            "template"
        ],
        "types": ["vite/client"]
    },
    "nodeModulesDir": "auto"
}
