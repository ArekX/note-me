# Database connection as <type>://<dsn>, defaults to sqlite://:memory: (in memory)
# sqlite://path/to/database.sqlite
# postgres://user:password@host:5432/database?sslmode=disable (postgresql:// works too)
# mysql://user:password@host:3306/database (MySQL 8.4 or newer)
DATABASE_DSN=sqlite://database.sqlite

# Use and require secure cookies, defaults to 1, disable if not using HTTPS.
COOKIE_SECURE=1

# Maximum age of the cookie in seconds, defaults to 30 days in seconds
COOKIE_MAX_AGE_SECONDS=2592000

# Address websocket and webserver should bind to, defaults to 127.0.0.1
SERVER_ADDRESS=127.0.0.1

# Port for webserver service, defaults to 8000
WEBSERVER_PORT=8000

# Logging level. Levels: DEBUG, INFO, WARN, ERROR, defaults to: INFO
LOGGING_LEVEL=INFO

# Whether or not to color log entries, defaults to 1
SHOW_LOG_COLORS=1

# Maximum file size allowed for uploads in bytes, defaults to 52428800 (50MB)
MAX_FILE_SIZE=52428800

# Maximum total size of one user's uploaded files in bytes, defaults to 0 (unlimited)
MAX_USER_STORAGE_SIZE=0

# Maximum number of backup files to keep, defaults to 5, set to 0 to disable backups
# Backup is run once a day at midnight so limit of 5 means 5 last days of backups
MAX_ALLOWED_BACKUP_COUNT=5

# Secret used to encrypt every backup; required. This one is for development only.
BACKUP_ENCRYPTION_KEY=development-backup-key

# Secret used to encrypt AI provider API keys; required. This one is for development only.
AI_ENCRYPTION_KEY=development-ai-key

# Folder that holds every "local" backup target: a target's location is a folder name
# inside it, never an absolute path. Relative paths resolve against the working directory
LOCAL_BACKUP_ROOT_LOCATION=backup

# Folder for uploaded files, relative paths resolve against the working directory, created if missing, defaults to the files folder next to the executable
FILES_LOCATION=files

# Reverse proxies whose X-Forwarded-For header is trusted for the client address (login rate limiting), comma separated addresses or CIDR ranges, defaults to none
# TRUSTED_PROXIES=127.0.0.1,::1

# Wrong passwords a signed in user may enter (protected notes, password change, passkeys, export)
# before those checks are locked for 24 hours, defaults to 10
MAX_PASSWORD_ATTEMPTS=10

# Maximum open websocket connections (browser tabs) per user, defaults to 0 (unlimited)
MAX_CONNECTIONS_PER_USER=0

# Days of periodic task runs kept and shown in Settings > Tasks, defaults to 30
PERIODIC_TASK_HISTORY_DAYS=30

# Application url
APP_URL=http://localhost:5173
